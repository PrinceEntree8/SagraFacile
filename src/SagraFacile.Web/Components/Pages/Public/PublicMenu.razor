@page "/menu"
@using SagraFacile.Application.Features.Events
@using SagraFacile.Application.Features.Menu
@using SagraFacile.Application.Features.Reservations
@using SagraFacile.Application.Infrastructure.CQRS
@using SagraFacile.Contracts.Menu
@using SagraFacile.Contracts.Reservations
@using SagraFacile.WebClient.Resources
@inject IMediator Mediator
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["PublicMenu_PageTitle"]</PageTitle>

<div class="container py-4">
    @if (activeEvent is null)
    {
        <div class="text-center text-muted mt-5">
            <h2>@L["PublicMenu_NoActiveEvent"]</h2>
        </div>
    }
    else
    {
        <div class="text-center mb-4">
            <h1>🍽️ @activeEvent.Name</h1>
        </div>

        <div class="text-center mb-4">
            <a class="btn btn-outline-primary btn-lg" href="/">
                @L["PublicMenu_GoToHome"]
            </a>
        </div>

        <section class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">@L["PublicMenu_LatestCalled"]</h2>
                @if (initialLoadFailed)
                {
                    <div class="alert alert-warning mb-3" role="alert">
                        @L["NowCalling_LoadWarning"]
                    </div>
                }
                @if (latestCalled is null)
                {
                    <p class="text-muted mb-0">@L["PublicMenu_NoCalledYet"]</p>
                }
                else
                {
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge bg-primary fs-6">#@latestCalled.SequenceNumber</span>
                        <span class="fw-semibold">@latestCalled.CustomerName</span>
                        <span class="text-muted"><i class="bi bi-people"></i> @latestCalled.PartySize</span>
                    </div>
                }
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(menuDetails?.WarningMessage))
        {
            <div class="alert alert-warning">@((MarkupString)menuDetails.WarningMessage)</div>
        }
        @if (!string.IsNullOrWhiteSpace(menuDetails?.Header))
        {
            <div class="menu-header mb-4">@((MarkupString)menuDetails.Header)</div>
        }

        @if (!items.Any())
        {
            <p class="text-center text-muted">@L["PublicMenu_NoItems"]</p>
        }
        else
        {
            @foreach (var catGroup in items
                .GroupBy(i => i.CategoryId)
                .OrderBy(g => categories.FirstOrDefault(c => c.Id == g.Key)?.DisplayOrder ?? 999))
            {
                var categoryName = categories.FirstOrDefault(c => c.Id == catGroup.Key)?.Name
                    ?? catGroup.FirstOrDefault(i => !string.IsNullOrWhiteSpace(i.CategoryName))?.CategoryName
                    ?? string.Empty;

                <section class="mb-5">
                    <h2 class="border-bottom pb-2">@categoryName</h2>
                    <div class="row row-cols-1 row-cols-md-2 g-3 mt-1">
                        @foreach (var item in catGroup.OrderBy(i => i.DisplayOrder).ThenBy(i => i.Name))
                        {
                            <div class="col">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <h5 class="card-title mb-1">@item.Name</h5>
                                            <span class="badge bg-primary fs-6 ms-2">
                                                @activeEvent.CurrencySymbol @((item.PriceCents / 100.0).ToString("0.00"))
                                            </span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <p class="card-text text-muted small mb-2">@item.Description</p>
                                        }
                                        @if (item.Allergens.Any())
                                        {
                                            <div>
                                                <small class="text-muted">@L["PublicMenu_Allergens"]: </small>
                                                @foreach (var a in item.Allergens)
                                                {
                                                    <span class="badge bg-warning text-dark me-1" title="@L[$"Allergen_{a.Code}"]">
                                                        @a.Icon @a.Code
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
        }
        @if (!string.IsNullOrWhiteSpace(menuDetails?.Footer))
        {
            <div class="menu-footer mt-4">@((MarkupString)menuDetails.Footer)</div>
        }
    }
</div>

@code {
    private GetActiveEvent.EventDto? activeEvent;
    private IReadOnlyList<MenuItemDto> items = [];
    private IReadOnlyList<MenuCategoryDto> categories = [];
    private MenuDetailsDto? menuDetails;
    private CalledEntry? latestCalled;
    private bool initialLoadFailed;

    protected override async Task OnInitializedAsync()
    {
        var activeEventResult = await Mediator.QueryAsync(new GetActiveEvent.Query());
        activeEvent = activeEventResult.ActiveEvent;
        if (activeEvent is not null)
        {
            categories = (await Mediator.QueryAsync(new GetMenuCategories.Query())).Categories;
            items = (await Mediator.QueryAsync(new GetEventMenu.Query(activeEvent.Id, false))).Items;
            menuDetails = (await Mediator.QueryAsync(new GetMenuDetails.Query(activeEvent.Id))).Details;

            try
            {
                var lastCalled = await Mediator.QueryAsync(new GetLastCalled.Query(activeEvent.Id, 1));
                latestCalled = lastCalled.FirstOrDefault();
            }
            catch
            {
                initialLoadFailed = true;
            }
        }
    }
}
