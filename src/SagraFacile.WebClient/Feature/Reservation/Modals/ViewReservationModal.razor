@using Microsoft.Extensions.Localization
@using SagraFacile.Contracts.Reservations
@using SagraFacile.WebClient.Extensions
@using SagraFacile.WebClient.Components.Buttons
@using SagraFacile.Domain.Features.Reservations
@using SagraFacile.WebClient.Feature.Reservation
@inject IStringLocalizer<SharedResource> L
@inject IReservationService ReservationService
<div class="modal fade" id="reservationDetailModal" tabindex="-1" aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">@L["ReservationView_ModalTitle"] <strong>#@Reservation?.SequenceNumber</strong></h5>
                <button type="button" class="btn-close @(Reservation is not null ? "" : "ms-auto")" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            @if (isEditing && Reservation is not null)
            {
                <div class="modal-body">
                    <EditReservationForm Reservation="Reservation" OnSave="SaveReservationChanges" ShowReservationId="false" />
                </div>
            }
            else
            {
                <div class="modal-body">
                    @if (Reservation is not null)
                    {
                        <div class="mb-2">
                            @L["Receptionist_ColStatus"]:
                            <span class="badge chip-status @StatusClass">@L["Reservation_Status_" + Reservation.Status]</span>
                        </div>
                        <div class="mb-2">
                            @L["Receptionist_ColName"]:
                            @Reservation.CustomerName
                        </div>
                        <div class="mb-2">
                            @L["Receptionist_ColParty"]:
                            <span class="badge bg-secondary"><i class="bi bi-people"></i> @Reservation.PartySize</span>
                        </div>

                        @if (Reservation.Status is not ("Seated" or "Left"))
                        {
                            <div class="mb-2">
                                @L["Receptionist_ColWaiting"]:
                                <span class="chip-wait text-muted ms-1">
                                    @WaitingTimeFormatted
                                </span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Reservation.Notes))
                        {
                            <div class="text-muted">@Reservation.Notes</div>
                        }
                    }
                </div>

                <div class="modal-footer">
                    @if (Reservation is not null)
                    {
                        <ServiceButton Reservation="Reservation"
                                       PartyCompletionEnabled="PartyCompletionEnabled"
                                       OnMarkPartyComplete="OnMarkPartyComplete"
                                       OnCall="OnCall"
                                       OnSeat="OnSeat"
                                       OnRestore="OnRestore"
                                       IsDisabled="IsActionDisabled" />
                    }
                    <AuthorizeView Roles="reservation:edit,admin">
                        Can Edit!
                    </AuthorizeView>
                    @if (Reservation is not null)
                    {
                        <button type="button" class="btn btn-outline-secondary ms-auto me-2"
                                data-bs-toggle="modal"
                                data-bs-target="#reservationEditModal">
                            <i class="bi bi-pencil"></i> @L["Receptionist_ActionEdit"]
                        </button>
                    }
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Common_Close"]</button>
                </div>
            }
        </div>
    </div>
</div>

<EditReservationModal Reservation="Reservation" />

@code {
    private bool isEditing;

    [Parameter]
    public required ReservationDto? Reservation
    {
        get;
        set
        {
            field = value;
            isEditing = false;
        }
    }

    [Parameter] public bool PartyCompletionEnabled { get; set; }
    [Parameter] public EventCallback OnMarkPartyComplete { get; set; }
    [Parameter] public EventCallback OnCall { get; set; }
    [Parameter] public EventCallback OnSeat { get; set; }
    [Parameter] public EventCallback OnRestore { get; set; }
    [Parameter] public bool IsActionDisabled { get; set; }

    private void ToggleEdit() => isEditing = !isEditing;

    private async Task SaveReservationChanges(EditReservationModel model)
    {
        if (Reservation is null)
        {
            throw new ArgumentNullException(nameof(Reservation), L["Error_ModelNotValid"]);
        }
        
        await ReservationService.EditAsync(
            Reservation.Id,
            new EditReservationRequest(
                CustomerName: model.CustomerName,
                PartySize: model.PartySize,
                Notes: model.Notes,
                Status: Enum.Parse<ReservationStatus>(model.Status)),
            CancellationToken.None);
        isEditing = false;
    }

    private string WaitingTimeFormatted
    {
        get
        {
            if (Reservation?.TimeSinceLastCall.HasValue ?? false)
            {
                return Reservation.TimeSinceLastCall.Value.FormatTimeSpan();
            }

            return Reservation?.WaitingTime.FormatTimeSpan() ?? L["Common_NotAvailable"];
        }
    }

    private string StatusClass => Reservation?.Status.GetStatusClass() ?? string.Empty;
    
}

<style>
    .chip-status {
        background-color: var(--background-color);
    }
</style>