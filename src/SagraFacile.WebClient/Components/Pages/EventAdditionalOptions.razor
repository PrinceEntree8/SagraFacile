@page "/events/{EventId:int}/options"
@attribute [Authorize(Roles = "Admin")]
@inject IEventService EventService
@inject IStringLocalizer<SharedResource> L
@using SagraFacile.Domain.Features.Orders

<PageTitle>@string.Format(L["EventOptions_PageTitle"], eventName)</PageTitle>

<div class="mb-3">
    <a href="/events" class="btn btn-outline-secondary btn-sm">@L["EventOptions_BackToEvents"]</a>
</div>

<h1>@L["EventOptions_Heading"]</h1>
@if (!string.IsNullOrEmpty(eventName))
{
    <p class="text-muted">@eventName</p>
}

@if (isLoading)
{
    <p><em>@L["EventOptions_Loading"]</em></p>
}
else if (notFound)
{
    <div class="alert alert-warning">@L["EventOptions_EventNotFound"]</div>
}
else
{
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(saveSuccess ? "alert-success" : "alert-danger")">@statusMessage</div>
    }

    <div class="row">
        <div class="col-md-7">

            <!-- Reservation Options -->
            <div class="card mb-4">
                <div class="card-header">
                    <h4 class="mb-0">@L["EventOptions_ReservationOptions"]</h4>
                </div>
                <div class="card-body">

                    <!-- Party Completion -->
                    <h5>@L["EventOptions_PartyCompletion"]</h5>
                    <p class="text-muted small">@L["EventOptions_PartyCompletionDesc"]</p>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="partyCompletionEnabled"
                               @bind="model.PartyCompletionEnabled" />
                        <label class="form-check-label" for="partyCompletionEnabled">
                            @L["EventOptions_EnablePartyCompletion"]
                        </label>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="minPartySize">@L["EventOptions_MinPartySize"]</label>
                        <input type="number" class="form-control" id="minPartySize" min="1"
                               @bind="model.MinPartySize" style="max-width: 120px;" />
                        <div class="form-text">@L["EventOptions_MinPartySizeDesc"]</div>
                    </div>

                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h4 class="mb-0">@L["EventOptions_ViewOptions"]</h4>
                </div>
                <div class="card-body">
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="showNotesField"
                               @bind="model.ShowNotesField" />
                        <label class="form-check-label" for="showNotesField">
                            @L["EventOptions_ShowNotesField"]
                        </label>
                        <div class="form-text">@L["EventOptions_ShowNotesFieldDesc"]</div>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="counterPeopleFirst"
                               @bind="model.CounterPeopleFirst" />
                        <label class="form-check-label" for="counterPeopleFirst">
                            @L["EventOptions_CounterPeopleFirst"]
                        </label>
                        <div class="form-text">@L["EventOptions_CounterPeopleFirstDesc"]</div>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="showCallCount"
                               @bind="model.ShowCallCount" />
                        <label class="form-check-label" for="showCallCount">
                            @L["EventOptions_ShowCallCount"]
                        </label>
                        <div class="form-text">@L["EventOptions_ShowCallCountDesc"]</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="maxWaitTimeMinutes">@L["EventOptions_MaxWaitTimeMinutes"]</label>
                        <input type="number" class="form-control" id="maxWaitTimeMinutes" min="1"
                               @bind="model.MaxWaitTimeMinutes" style="max-width: 120px;" />
                        <div class="form-text">@L["EventOptions_MaxWaitTimeMinutesDesc"]</div>
                    </div>
                </div>
            </div>

            <!-- Order Options -->
            <div class="card mb-4">
                <div class="card-header">
                    <h4 class="mb-0">@L["EventOptions_OrderOptions"]</h4>
                </div>
                <div class="card-body">
                    <h5>@L["EventOptions_EnabledContexts"]</h5>
                    <div class="mb-2 form-check">
                        <input type="checkbox" class="form-check-input" id="contextTable" @bind="model.ContextTable" />
                        <label class="form-check-label" for="contextTable">@L["EventOptions_ContextTable"]</label>
                    </div>
                    <div class="mb-2 form-check">
                        <input type="checkbox" class="form-check-input" id="contextReservation" @bind="model.ContextReservation" />
                        <label class="form-check-label" for="contextReservation">@L["EventOptions_ContextReservation"]</label>
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="contextTakeaway" @bind="model.ContextTakeaway" />
                        <label class="form-check-label" for="contextTakeaway">@L["EventOptions_ContextTakeaway"]</label>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="defaultConfirmerRole">@L["EventOptions_DefaultConfirmerRole"]</label>
                        <select class="form-select" id="defaultConfirmerRole" @bind="model.DefaultConfirmerRole" style="max-width: 200px;">
                            <option value="@OrderActor.Cashier">@L["Actor_Cashier"]</option>
                            <option value="@OrderActor.Supervisor">@L["Actor_Supervisor"]</option>
                            <option value="@OrderActor.Admin">@L["Actor_Admin"]</option>
                        </select>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="allowEditAfterConfirmation" @bind="model.AllowEditAfterConfirmation" />
                        <label class="form-check-label" for="allowEditAfterConfirmation">@L["EventOptions_AllowEditAfterConfirmation"]</label>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="allowFollowUpOrders" @bind="model.AllowFollowUpOrders" />
                        <label class="form-check-label" for="allowFollowUpOrders">@L["EventOptions_AllowFollowUpOrders"]</label>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="coverChargeEnabled" @bind="model.CoverChargeEnabled" />
                        <label class="form-check-label" for="coverChargeEnabled">@L["EventOptions_CoverChargeEnabled"]</label>
                    </div>

                    @if (model.CoverChargeEnabled)
                    {
                        <div class="mb-3">
                            <label class="form-label" for="defaultCoverCharge">@L["EventOptions_DefaultCoverCharge"] (€)</label>
                            <input type="number" step="0.01" min="0" class="form-control" id="defaultCoverCharge"
                                   @bind="model.CoverChargeEuro" style="max-width: 150px;" />
                        </div>
                    }
                </div>
            </div>

            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@isSaving">
                @if (isSaving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                @L["EventOptions_Save"]
            </button>

        </div>
    </div>
}

@code {
    [Parameter] public int EventId { get; set; }

    private string eventName = string.Empty;
    private bool isLoading = true;
    private bool notFound = false;
    private bool isSaving = false;
    private string statusMessage = string.Empty;
    private bool saveSuccess = false;

    private OptionsModel model = new();

    protected override async Task OnInitializedAsync()
    {
        var result = await EventService.GetEventOptionsAsync(EventId);
        if (result is null)
        {
            notFound = true;
        }
        else
        {
            model.PartyCompletionEnabled = result.IsPartyCompletionEnabled;
            model.MinPartySize = result.MinPartySize;
            model.ShowNotesField = result.ShowNotesField;
            model.CounterPeopleFirst = result.CounterPeopleFirst;
            model.ShowCallCount = result.ShowCallCount;
            model.MaxWaitTimeMinutes = result.MaxWaitTimeMinutes;

            if (result.EnabledContexts is not null)
            {
                model.ContextTable = result.EnabledContexts.Contains(OrderContext.Table);
                model.ContextReservation = result.EnabledContexts.Contains(OrderContext.Reservation);
                model.ContextTakeaway = result.EnabledContexts.Contains(OrderContext.Takeaway);
            }
            model.CoverChargeEnabled = result.CoverChargeEnabled;
            model.CoverChargeEuro = result.DefaultCoverChargeInCents / 100m;
            model.DefaultConfirmerRole = result.DefaultConfirmerRole;
            model.AllowEditAfterConfirmation = result.AllowEditAfterConfirmation;
            model.AllowFollowUpOrders = result.AllowFollowUpOrders;

            var events = await EventService.GetEventsAsync();
            eventName = events.FirstOrDefault(e => e.Id == EventId)?.Name ?? string.Empty;
        }
        isLoading = false;
    }

    private async Task SaveAsync()
    {
        statusMessage = string.Empty;

        if (model.MinPartySize < 1)
        {
            statusMessage = L["EventOptions_MinPartySizeInvalid"];
            saveSuccess = false;
            return;
        }

        if (model.MaxWaitTimeMinutes < 1)
        {
            statusMessage = L["EventOptions_MaxWaitTimeMinutesInvalid"];
            saveSuccess = false;
            return;
        }

        var enabledContexts = new List<OrderContext>();
        if (model.ContextTable) enabledContexts.Add(OrderContext.Table);
        if (model.ContextReservation) enabledContexts.Add(OrderContext.Reservation);
        if (model.ContextTakeaway) enabledContexts.Add(OrderContext.Takeaway);

        if (enabledContexts.Count == 0)
        {
            statusMessage = "At least one order context must be enabled.";
            saveSuccess = false;
            return;
        }

        int coverChargeCents = (int)(model.CoverChargeEuro * 100);
        if (coverChargeCents < 0)
        {
            statusMessage = "Cover charge cannot be negative.";
            saveSuccess = false;
            return;
        }

        isSaving = true;
        try
        {
            await EventService.UpdateEventOptionsAsync(EventId,
                new UpdateEventAdditionalOptionsRequest(
                    model.PartyCompletionEnabled,
                    model.MinPartySize,
                    model.ShowNotesField,
                    model.CounterPeopleFirst,
                    model.ShowCallCount,
                    model.MaxWaitTimeMinutes,
                    enabledContexts,
                    model.CoverChargeEnabled,
                    coverChargeCents,
                    model.DefaultConfirmerRole,
                    model.AllowEditAfterConfirmation,
                    model.AllowFollowUpOrders));

            statusMessage = L["EventOptions_Saved"];
            saveSuccess = true;
        }
        catch (Exception ex)
        {
            statusMessage = string.Format(L["EventOptions_Error"], ex.Message);
            saveSuccess = false;
        }
        isSaving = false;
    }

    private class OptionsModel
    {
        public bool PartyCompletionEnabled { get; set; } = false;
        public int MinPartySize { get; set; } = 8;
        public bool ShowNotesField { get; set; } = false;
        public bool CounterPeopleFirst { get; set; } = true;
        public bool ShowCallCount { get; set; } = false;
        public int MaxWaitTimeMinutes { get; set; } = 45;
        public bool ContextTable { get; set; } = true;
        public bool ContextReservation { get; set; } = true;
        public bool ContextTakeaway { get; set; } = true;
        public OrderActor DefaultConfirmerRole { get; set; } = OrderActor.Cashier;
        public bool AllowEditAfterConfirmation { get; set; } = false;
        public bool AllowFollowUpOrders { get; set; } = true;
        public bool CoverChargeEnabled { get; set; } = false;
        public decimal CoverChargeEuro { get; set; } = 0m;
    }
}
