@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using SagraFacile.Contracts.Reservations
@inject IReservationService ReservationService
@inject IReservationRealtimeService ReservationRealtimeService
@inject IStringLocalizer<SharedResource> L
@implements IAsyncDisposable

@if (initialLoadFailed)
{
    <div class="alert alert-warning mb-3" role="alert">
        @L["NowCalling_LoadWarning"]
    </div>
}
@if (latestCalled is null)
{
    <p class="text-muted mb-0">@L["PublicMenu_NoCalledYet"]</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center">
        <span class="badge bg-primary fs-6">#@latestCalled.SequenceNumber</span>
        <span class="fw-semibold">@latestCalled.CustomerName</span>
        <span class="text-muted"><i class="bi bi-people"></i> @latestCalled.PartySize</span>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public int EventId { get; set; }

    private CalledEntry? latestCalled;
    private bool initialLoadFailed;
    private IDisposable? reservationSubscription;

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialLatestCalledAsync();
        await InitializeSignalRAsync();
    }

    private async Task LoadInitialLatestCalledAsync()
    {
        try
        {
            var reservations = await ReservationService.GetLastCalledReservationsAsync(EventId, 1);
            latestCalled = reservations.FirstOrDefault();
        }
        catch
        {
            initialLoadFailed = true;
        }
    }

    private async Task InitializeSignalRAsync()
    {
        try
        {
            await ReservationRealtimeService.EnsureStartedAsync();

            reservationSubscription = ReservationRealtimeService.SubscribeReservationStatusChanged(async notification =>
            {
                if (notification.NewStatus != SagraFacile.Domain.Features.Reservations.ReservationStatus.Called)
                {
                    return;
                }

                latestCalled = new CalledEntry(
                    notification.ReservationId,
                    notification.SequenceNumber,
                    notification.CustomerName,
                    notification.PartySize,
                    notification.CallCount ?? 0);

                await InvokeAsync(StateHasChanged);
            });
        }
        catch
        {
            // Keep the widget usable even if the realtime hub is temporarily unavailable.
        }
    }

    public async ValueTask DisposeAsync()
    {
        reservationSubscription?.Dispose();
    }
}
