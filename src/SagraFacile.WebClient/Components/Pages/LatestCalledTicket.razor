@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: true))
@using SagraFacile.Contracts.Reservations
@using SagraFacile.Domain.Features.Reservations
@inject IServiceProvider Services
@inject IStringLocalizer<SharedResource> L
@implements IAsyncDisposable

@if (InitialLoadFailed)
{
    <div class="alert alert-warning mb-3" role="alert">
        @L["NowCalling_LoadWarning"]
    </div>
}
@if (latestCalled is null)
{
    <p class="text-muted mb-0">@L["PublicMenu_NoCalledYet"]</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center">
        <span class="badge bg-primary fs-6">#@latestCalled.SequenceNumber</span>
        <span class="fw-semibold">@latestCalled.CustomerName</span>
        <span class="text-muted"><i class="bi bi-people"></i> @latestCalled.PartySize</span>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public int EventId { get; set; }

    [Parameter]
    public CalledEntry? InitialLatestCalled { get; set; }

    [Parameter]
    public bool InitialLoadFailed { get; set; }

    private CalledEntry? latestCalled;
    private IDisposable? reservationSubscription;

    protected override void OnParametersSet()
    {
        latestCalled = InitialLatestCalled;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && EventId > 0)
        {
            await InitializeSignalRAsync();
        }
    }

    private async Task InitializeSignalRAsync()
    {
        try
        {
            var realtimeService = Services.GetRequiredService<IReservationRealtimeService>();
            await realtimeService.EnsureStartedAsync();

            reservationSubscription = realtimeService.SubscribeReservationStatusChanged(async notification =>
            {
                if (notification.NewStatus != ReservationStatus.Called)
                {
                    if (latestCalled?.Id == notification.ReservationId)
                    {
                        latestCalled = null;
                        await InvokeAsync(StateHasChanged);
                    }

                    return;
                }

                latestCalled = new CalledEntry(
                    notification.ReservationId,
                    notification.SequenceNumber,
                    notification.CustomerName,
                    notification.PartySize,
                    notification.CallCount ?? 0);

                await InvokeAsync(StateHasChanged);
            });
        }
        catch
        {
            // Keep the widget usable even if the realtime hub is temporarily unavailable.
        }
    }

    public async ValueTask DisposeAsync()
    {
        reservationSubscription?.Dispose();
    }
}
